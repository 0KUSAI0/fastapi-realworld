APP_ENV=dev
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/rwdb
SECRET_KEY=secret
MAX_CONNECTIONS_COUNT=10
MIN_CONNECTIONS_COUNT=1
ADMIN_USERNAMES=["admin"]

LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=qwen3-8b
LLM_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_FOLDER=
EMBEDDING_ALLOW_DOWNLOAD=false
EMBEDDING_FALLBACK_ENABLED=true

# off: do not moderate during normal comment creation
# log: moderate and save the decision, but still create the comment
# block: reject comments that the model marks as unsafe
AI_COMMENT_MODERATION_MODE=block
AI_ARTICLE_REVIEW_ON_PUBLISH=true
AI_ARTICLE_MIN_CONTENT_SCORE=50
